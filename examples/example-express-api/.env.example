AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Only needed for the exchange endpoints.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# /api/on-behalf-of and /api/token-exchange.
AUTH0_DOWNSTREAM_AUDIENCE=

# /api/connection-token, for example google-oauth2.
AUTH0_CONNECTION=

# /api/token-exchange, matching your Token Exchange Profile.
AUTH0_SUBJECT_TOKEN_TYPE=
