AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SESSION_SECRET=

# Default Auth0 custom domain, used when the request host is not in the map below.
AUTH0_DOMAIN=

# Multiple Custom Domains: one Auth0 custom domain per served host.
# All must be custom domains of the SAME Auth0 tenant.
AUTH0_CUSTOM_DOMAIN_1=
AUTH0_CUSTOM_DOMAIN_2=

# Allow-list of application base URLs, comma-separated.
# Each incoming request's origin is matched against this list, and the matching
# entry is used as the base URL for callbacks, redirects, and logout.
APP_BASE_URL=http://tenant-1.localhost:3000,http://tenant-2.localhost:3000
