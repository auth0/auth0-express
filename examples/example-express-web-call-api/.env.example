AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SESSION_SECRET=
APP_BASE_URL=http://localhost:3000

# The identifier (audience) of the API the web app calls on the user's behalf.
# This must match the audience the companion resource server validates.
AUTH0_AUDIENCE=

# Base URL of the companion resource server started by `npm start`.
API_BASE_URL=http://localhost:3001
# Port the companion resource server listens on.
API_PORT=3001
