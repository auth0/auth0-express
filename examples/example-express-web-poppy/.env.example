AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# A long random string that encrypts the session cookie. Make one with: openssl rand -hex 64
AUTH0_SESSION_SECRET=

# The https URL of the site, such as https://shop.example.com. It is the address that agents and people use.
APP_BASE_URL=

# The identifier of the API that the access token of the agent is for. Auth0 ties the sign-in of the user of an agent to it, so
# set it when your tenant has no default audience, or its default audience is another API. Leave the line out otherwise.
# AUTH0_AUDIENCE=https://shop.example.com/api
